# QuantMind QwenPaw 扩展镜像
#
# 在上游 agentscope/qwenpaw 基础上补齐两项能力：
# 1. reportlab（研报级 MD→PDF：backend/scripts/md_to_pdf_report.py）
# 2. docker CLI（静态二进制，配合已挂载的 /var/run/docker.sock 执行
#    `docker exec quantmind ...` 等操作）
FROM agentscope/qwenpaw:latest

# reportlab：安装到 QwenPaw 自带 venv（容器内 python 即 /app/venv/bin/python）
RUN /app/venv/bin/pip install --no-cache-dir \
    -i https://pypi.tuna.tsinghua.edu.cn/simple/ reportlab

# docker CLI 静态二进制（版本与宿主机 Docker Engine 保持一致）
ARG DOCKER_CLI_VERSION=29.7.2
RUN curl -fsSL \
    "https://mirrors.aliyun.com/docker-ce/linux/static/stable/x86_64/docker-${DOCKER_CLI_VERSION}.tgz" \
    -o /tmp/docker.tgz \
    && tar -xzf /tmp/docker.tgz -C /tmp docker/docker \
    && mv /tmp/docker/docker /usr/local/bin/docker \
    && chmod +x /usr/local/bin/docker \
    && rm -f /tmp/docker.tgz
